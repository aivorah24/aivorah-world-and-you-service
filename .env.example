# Server
PORT=3010

# Groq — GK Fact, On This Day, Fun Challenge, current-affairs simplification, comprehension quiz
GROQ_API_KEY=

# NewsAPI — current affairs headlines (falls back to Groq-generated content if unset)
NEWS_API_KEY=

# Supabase — student_stats XP updates after quiz completion; Current Affairs tables (ca_*)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Current Affairs (/current-affairs) ──────────────────────────────────────
# Firebase service account, to verify students' and editors' ID tokens.
# Either the JSON base64-encoded (preferred on Render) or the raw JSON.
FIREBASE_SERVICE_ACCOUNT_B64=
FIREBASE_SERVICE_ACCOUNT=
# Unset or "enforce" = a student can only read/change their own progress.
# "monitor" only logs what would be blocked — local development ONLY.
# AUTH_ENFORCE must NOT be "monitor" in production.
AUTH_ENFORCE=
# Calendar day for "today's digest" and the quiz week (default Asia/Kolkata).
CA_TIME_ZONE=
# Admin content tool: who may edit and publish (comma-separated emails).
ADMIN_EMAIL=
ADMIN_EMAILS=
CA_EDITOR_EMAILS=
# Daily news pipeline (POST /current-affairs/pipeline/run) and weekly quiz
# generator (POST /current-affairs/pipeline/quiz). They save for review only.
# Writes happen only when CA_PIPELINE_ENABLED=true; callers send the header
# x-pipeline-secret: <CA_PIPELINE_SECRET> (a long random string).
CA_PIPELINE_ENABLED=
CA_PIPELINE_SECRET=
